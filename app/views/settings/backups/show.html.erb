<%= content_for :page_title, t(".title") %>

<%= settings_section title: t(".status_title") do %>
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="space-y-1">
        <p class="text-sm"><%= t(".last_backup_label") %></p>
        <p class="text-secondary text-sm">
          <% if Setting.last_backup_at.present? %>
            <% timestamp = Time.zone.parse(Setting.last_backup_at) rescue nil %>
            <%= timestamp ? l(timestamp, format: :long) : Setting.last_backup_at %>
            &middot;
            <% if Setting.last_backup_status == "success" %>
              <span class="text-green-600"><%= t(".status_success") %></span>
              (<%= number_to_human_size(Setting.last_backup_size_bytes) if Setting.last_backup_size_bytes.present? %>)
            <% else %>
              <span class="text-destructive"><%= t(".status_failed") %></span>
            <% end %>
          <% else %>
            <%= t(".never_run") %>
          <% end %>
        </p>
        <% if Setting.last_backup_status == "failed" && Setting.last_backup_error.present? %>
          <%= render DS::Alert.new(message: Setting.last_backup_error, variant: :destructive) %>
        <% end %>
      </div>

      <%= button_to t(".run_now"), run_now_settings_backup_path, method: :post,
            class: "shrink-0 bg-primary text-inverse text-sm font-medium rounded-lg px-4 py-2" %>
    </div>
  </div>
<% end %>

<%= settings_section title: t(".schedule_title") do %>
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="space-y-1">
        <p class="text-sm"><%= t(".backup_enabled_label") %></p>
        <p class="text-secondary text-sm"><%= t(".backup_enabled_description") %></p>
      </div>

      <%= styled_form_with model: Setting.new,
                           url: settings_backup_path,
                           method: :patch,
                           data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
        <%= form.toggle :backup_enabled,
                        checked: Setting.backup_enabled,
                        data: { auto_submit_form_target: "auto" } %>
      <% end %>
    </div>

    <div class="flex items-center justify-between">
      <div class="space-y-1">
        <p class="text-sm"><%= t(".backup_time_label") %></p>
        <p class="text-secondary text-sm"><%= t(".backup_time_description") %></p>
      </div>

      <%= form_with model: Setting.new,
                    url: settings_backup_path,
                    method: :patch,
                    data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
        <%= form.time_field :backup_time,
                            value: Setting.backup_time,
                            disabled: !Setting.backup_enabled,
                            class: "rounded-lg border border-primary px-3 py-2 text-sm bg-container text-primary w-full",
                            data: { auto_submit_form_target: "auto" } %>
      <% end %>
    </div>

    <div class="flex items-center justify-between">
      <div class="space-y-1">
        <p class="text-sm"><%= t(".backup_keep_days_label") %></p>
        <p class="text-secondary text-sm"><%= t(".backup_keep_days_description") %></p>
      </div>

      <%= form_with model: Setting.new,
                    url: settings_backup_path,
                    method: :patch,
                    data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
        <%= form.number_field :backup_keep_days,
                              value: Setting.backup_keep_days,
                              min: 1,
                              class: "rounded-lg border border-primary px-3 py-2 text-sm bg-container text-primary w-24",
                              data: { auto_submit_form_target: "auto" } %>
      <% end %>
    </div>
  </div>
<% end %>

<%= settings_section title: t(".gdrive_title"), subtitle: t(".gdrive_subtitle") do %>
  <%= styled_form_with model: Setting.new, url: settings_backup_path, method: :patch, class: "space-y-4" do |form| %>
    <div class="space-y-1">
      <label class="text-sm font-medium"><%= t(".gdrive_folder_id_label") %></label>
      <%= form.text_field :gdrive_folder_id,
                          value: Setting.gdrive_folder_id,
                          placeholder: "1AbCdEfGhIjKlMnOpQrStUvWxYz",
                          class: "rounded-lg border border-primary px-3 py-2 text-sm bg-container text-primary w-full" %>
      <p class="text-secondary text-sm"><%= t(".gdrive_folder_id_hint") %></p>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium"><%= t(".gdrive_service_account_label") %></label>
      <%= form.text_area :gdrive_service_account_json,
                         value: Setting.gdrive_service_account_json.present? ? "********" : "",
                         rows: 4,
                         placeholder: "{ \"type\": \"service_account\", ... }",
                         class: "rounded-lg border border-primary px-3 py-2 text-sm bg-container text-primary w-full font-mono" %>
      <p class="text-secondary text-sm"><%= t(".gdrive_service_account_hint") %></p>
    </div>

    <%= form.submit t(".save"), class: "bg-primary text-inverse text-sm font-medium rounded-lg px-4 py-2 cursor-pointer" %>
  <% end %>

  <%= render DS::Alert.new(message: t(".gdrive_quota_warning"), variant: :warning) %>
<% end %>
